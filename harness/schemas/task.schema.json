{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Odin task input",
  "type": "object",
  "required": ["id", "kind", "title", "request"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"},
    "kind": {"enum": ["feature", "bugfix"]},
    "title": {"type": "string", "minLength": 1},
    "request": {"type": "string", "minLength": 1},
    "context": {"type": "object"},
    "constraints": {"type": "array", "items": {"type": "string"}},
    "reproduction": {
      "type": "object",
      "properties": {
        "steps": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "expected": {"type": "string", "minLength": 1},
        "actual": {"type": "string", "minLength": 1}
      },
      "required": ["steps", "expected", "actual"],
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {"properties": {"kind": {"const": "bugfix"}}, "required": ["kind"]},
      "then": {"required": ["reproduction"]}
    }
  ],
  "additionalProperties": true
}
